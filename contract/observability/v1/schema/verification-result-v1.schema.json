{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/verification-result-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "companion", "target", "app", "pack", "capabilityDigest", "suite", "run", "result", "checks", "expiresAt"],
  "properties": {
    "apiVersion": {"const": "inari.dev/v1alpha1"},
    "kind": {"const": "ObservabilityVerificationResult"},
    "companion": {
      "type": "object", "additionalProperties": false, "required": ["id", "generation"],
      "properties": {"id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}}
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision", "clusterId"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1},
        "clusterId": {"type": "string", "minLength": 1}
      }
    },
    "app": {
      "type": "object", "additionalProperties": false, "required": ["planId", "sourceDigest", "revision"],
      "properties": {
        "planId": {"type": "string", "minLength": 1}, "instanceId": {"type": "string"}, "scaffoldRunId": {"type": "string"},
        "sourceDigest": {"$ref": "#/$defs/digest"}, "revision": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["instanceId"]}, {"required": ["scaffoldRunId"]}]
    },
    "pack": {
      "type": "object", "additionalProperties": false, "required": ["itemId", "version", "digest"],
      "properties": {
        "itemId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "capabilityDigest": {"$ref": "#/$defs/digest"},
    "suite": {
      "type": "object", "additionalProperties": false, "required": ["digest", "profile"],
      "properties": {"digest": {"$ref": "#/$defs/digest"}, "profile": {"enum": ["ci", "stage", "prod"]}}
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["id", "attempt", "finishedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1},
        "finishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "result": {"enum": ["passed", "failed"]},
    "checks": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "folder": {"$ref": "#/$defs/check"},
        "dashboards": {"type": ["array", "null"], "items": {"$ref": "#/$defs/check"}},
        "datasources": {"type": ["array", "null"], "items": {"$ref": "#/$defs/check"}},
        "rules": {"type": ["array", "null"], "items": {"$ref": "#/$defs/check"}}
      }
    },
    "expiresAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "passed"}}, "required": ["result"]},
      "then": {"properties": {"checks": {"$ref": "#/$defs/passedChecks"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "check": {"type": "object", "properties": {"state": {"type": "string"}}, "additionalProperties": true},
    "passedChecks": {
      "type": "object", "additionalProperties": false, "required": ["folder", "dashboards", "datasources", "rules"],
      "properties": {
        "folder": {
          "type": "object", "additionalProperties": false, "required": ["state", "name", "uid"],
          "properties": {
            "state": {"const": "passed"}, "name": {"type": "string", "minLength": 1}, "uid": {"type": "string", "minLength": 1}
          }
        },
        "dashboards": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["state", "uid", "title", "slug"],
            "properties": {
              "state": {"const": "passed"}, "uid": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
              "slug": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
            }
          }
        },
        "datasources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["state", "logical", "name", "type"],
            "properties": {
              "state": {"const": "passed"}, "logical": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}
            }
          }
        },
        "rules": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["state", "file", "evaluation"],
            "properties": {
              "state": {"const": "passed"}, "file": {"type": "string", "minLength": 1},
              "evaluation": {"enum": ["central", "local"]}
            }
          }
        }
      }
    }
  }
}
