{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inari.dev/schemas/catalog-index-v1.schema.json",
  "title": "Inari CatalogIndex v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "mediaType",
    "sourceSha",
    "sourceRef",
    "producer",
    "packages"
  ],
  "properties": {
    "apiVersion": {
      "const": "inari.dev/v1"
    },
    "kind": {
      "const": "CatalogIndex"
    },
    "mediaType": {
      "const": "application/vnd.inari.catalog.index.v1+yaml"
    },
    "sourceSha": {
      "$ref": "#/$defs/sha"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowPath",
        "workflowSha",
        "runId",
        "runAttempt",
        "runUri"
      ],
      "properties": {
        "workflowPath": {
          "const": ".github/workflows/release.yml"
        },
        "workflowSha": {
          "$ref": "#/$defs/sha"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "runUri": {
          "type": "string",
          "pattern": "^https://github.com/"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "packageVersion",
        "channel",
        "type",
        "description",
        "ociRef",
        "digest",
        "sourceSha",
        "releaseTag",
        "mediaType",
        "producer",
        "lanes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "stable",
            "incubating",
            "edge"
          ]
        },
        "type": {
          "enum": [
            "kro-rgd",
            "platform-app",
            "policy-pack",
            "crossplane-claim",
            "manifests",
            "kustomize"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "ociRef": {
          "type": "string",
          "not": {
            "pattern": ":latest$"
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "sourceSha": {
          "$ref": "#/$defs/sha"
        },
        "releaseTag": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "const": "application/vnd.inari.catalog.package.v1+yaml"
        },
        "producer": {
          "$ref": "#/$defs/artifactProducer"
        },
        "chartRef": {
          "type": "string",
          "pattern": "^oci://"
        },
        "chartDigest": {
          "$ref": "#/$defs/digest"
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lane"
          }
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "platform-app"
              }
            }
          },
          "then": {
            "required": [
              "chartRef",
              "chartDigest"
            ]
          }
        }
      ]
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required",
        "status",
        "runId",
        "jobId",
        "sourceSha"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "pending"
          ]
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "$ref": "#/$defs/sha"
        }
      },
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix",
        "result",
        "completedAt",
        "browser",
        "slots"
      ],
      "properties": {
        "matrix": {
          "type": "object",
          "required": [
            "stable",
            "previous-stable"
          ],
          "properties": {
            "stable": {
              "const": "passed"
            },
            "previous-stable": {
              "const": "passed"
            }
          }
        },
        "result": {
          "const": "passed"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "browser": {
          "const": "passed"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "suiteDigest",
        "profile",
        "result"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "suiteDigest": {
          "$ref": "#/$defs/digest"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "const": "passed"
        }
      }
    },
    "artifactProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowPath",
        "workflowSha",
        "runId",
        "runAttempt",
        "runUri"
      ],
      "properties": {
        "workflowPath": {
          "const": ".github/workflows/release-oci.yml"
        },
        "workflowSha": {
          "$ref": "#/$defs/sha"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "runUri": {
          "type": "string",
          "pattern": "^https://github.com/"
        }
      }
    }
  }
}
